{
  "name": "openclaw-memory-reflectlog",
  "version": "0.1.0",
  "description": "OpenClaw memory slot provider backed by the ReflectLog MCP server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "typebox": "1.3.36",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.1-beta.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "commander": "15.0.0",
    "openclaw": "2026.10.1-beta.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "openclaw-memory-reflectlog",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.1-beta.2"
    },
    "compat": {
      "pluginApi": ">=2026.10.1-beta.2",
      "minGatewayVersion": "2026.10.1-beta.2"
    },
    "build": {
      "openclawVersion": "2026.10.1-beta.2"
    }
  }
}
