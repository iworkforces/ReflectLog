{
  "name": "@iworkforces/openclaw-memory-reflectlog",
  "version": "0.1.1",
  "description": "OpenClaw memory slot provider backed by the ReflectLog MCP server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:dist": "node --test tests/compiled/smoke.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:dist"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "typebox": "1.4.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "commander": "15.0.0",
    "openclaw": "2026.10.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@iworkforces/openclaw-memory-reflectlog",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.4"
    },
    "compat": {
      "pluginApi": ">=2026.10.4",
      "minGatewayVersion": "2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4"
    }
  }
}
