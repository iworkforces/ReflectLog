# Required
WORKSPACE_ID=my-workspace
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Transport
MCP_TRANSPORT=stdio
MCP_PORT=9103
MCP_HOST=127.0.0.1
# Required when MCP_TRANSPORT is not stdio
# MCP_AUTH_TOKEN=change-me
# ALLOW_PUBLIC_BIND=false

# Search
SEARCH_LIMIT=5
FUSION_RANKING_THRESHOLD=0.0
RECENCY_DECAY_RATE=0.001
RERANKER_ENGINE=cross_encoder
RERANKER_MIN_RESULTS=1
SEARCH_SCORE_THRESHOLD=0.5
USEARCH_EXACT_SEARCH=false
USEARCH_EXACT_SEARCH_THRESHOLD=256
ENABLE_RRF_FUSION=true

# Payload limits
MAX_ADD_BATCH=100
MAX_ADD_CHARS=500000
GET_ALL_LIMIT=1000

# Optional profile: simple | balanced | performance | quality
# REFLECTLOG_PROFILE=balanced
