OPENROUTER_API_KEY=xxx
LLM_MODEL=xxx

# Embeddings
EMBEDDER_PROVIDER=langchain
EMBEDDING_MODEL=voyageai/voyage-4-lite
QWEN_EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=16

# Transport
MCP_TRANSPORT=http
MCP_PORT=9103
MCP_HOST=127.0.0.1
REFLECTLOG_MCP_AUTH_TOKEN=xxx

# Search
SEARCH_LIMIT=5
FUSION_RANKING_THRESHOLD=0.0
RECENCY_DECAY_RATE=0.001
RERANKER_ENGINE=openrouter
OPENROUTER_RERANK_MODEL=voyageai/rerank-2.5-lite
RERANKER_MIN_RESULTS=1
SEARCH_SCORE_THRESHOLD=0.5
USEARCH_EXACT_SEARCH=false
USEARCH_EXACT_SEARCH_THRESHOLD=256
ENABLE_RRF_FUSION=true

# Payload limits
MAX_ADD_BATCH=100
MAX_ADD_CHARS=500000
GET_ALL_LIMIT=1000

# Optional profile: simple | balanced | performance | quality
REFLECTLOG_PROFILE=quality
LOG_LEVEL=DEBUG

WORKSPACE_MAX_RESIDENT=100
